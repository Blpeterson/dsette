[Unit]
Description=Perform fixed Datasette start

[Service]
Type=oneshot
User=root
Group=dsette
ExecStart=/bin/systemctl start dsette
ExecStartPost=/usr/bin/rm -f /run/dsette-control/start
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/dsette-control
RestrictAddressFamilies=AF_UNIX
